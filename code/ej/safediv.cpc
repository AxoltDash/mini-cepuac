; Division segura: falla antes de interpretar si no se tiene una prueba
; de que el denominador no es cero.
(let (safeDiv : int -> ({ y : int | y != 0 } -> int)
      (lambda : int -> ({ y : int | y != 0 } -> int) (x)
        (lambda : { y : int | y != 0 } -> int (y)
          (/ x y)
        )
      )
    )
  ((safeDiv 10) 2)
)
